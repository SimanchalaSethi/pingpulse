# ── Redis (shared by all services) ───────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── auth-service ─────────────────────────────────────────────────────
AUTH_POSTGRES_HOST=localhost
AUTH_POSTGRES_PORT=5432
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── notification-service ─────────────────────────────────────────────
NOTIF_POSTGRES_HOST=localhost
NOTIF_POSTGRES_PORT=5433
NOTIF_POSTGRES_DB=notifications_db
NOTIF_POSTGRES_USER=postgres
NOTIF_POSTGRES_PASSWORD=postgres

# ── delivery-service ─────────────────────────────────────────────────
NOTIFICATION_SERVICE_URL=http://localhost:3002
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@pingpulse.local

# ── analytics-service ────────────────────────────────────────────────
ANALYTICS_POSTGRES_HOST=localhost
ANALYTICS_POSTGRES_PORT=5434
ANALYTICS_POSTGRES_DB=analytics_db
ANALYTICS_POSTGRES_USER=postgres
ANALYTICS_POSTGRES_PASSWORD=postgres

# ── api-gateway ──────────────────────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3002
ANALYTICS_SERVICE_URL=http://localhost:3004
RATE_LIMIT_PER_MINUTE=300
